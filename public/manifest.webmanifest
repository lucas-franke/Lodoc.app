{
  "name": "Lodoc",
  "short_name": "Lodoc",
  "description": "Notes and boards that live in your browser.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "shared_title",
      "text": "shared_text",
      "url": "shared_url",
      "files": [
        {
          "name": "shared_files",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Today's journal",
      "short_name": "Journal",
      "url": "./?journal",
      "icons": [
        { "src": "android-chrome-192x192.png", "sizes": "192x192" }
      ]
    }
  ],
  "icons": [
    { "src": "android-chrome-192x192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "android-chrome-512x512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
