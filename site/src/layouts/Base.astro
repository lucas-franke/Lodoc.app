---
import '../styles/site.css'

interface Props {
  title: string
  description: string
  /** A wider page (the docs, with their navigation beside the text) */
  wide?: boolean
}
const { title, description, wide = false } = Astro.props
const width = wide ? 'max-w-5xl' : 'max-w-3xl'
const base = import.meta.env.BASE_URL
// The app is at the root of the site, wherever that is (lodoc.app/ or the GitHub Pages folder)
const app = base
const nav = [
  { href: `${base}docs/`, label: 'Docs' },
  { href: `${base}changelog/`, label: "What's new" },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Lodoc: what's new" href={`${base}changelog/rss.xml`} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171717" media="(prefers-color-scheme: dark)" />
    <!-- The theme chosen in the app (same site, same storage), or the system's -->
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme') ?? 'system'
        const dark = theme === 'dark' || (theme === 'system' && matchMedia('(prefers-color-scheme: dark)').matches)
        document.documentElement.classList.toggle('dark', dark)
      } catch {}
    </script>
  </head>
  <body class="min-h-dvh">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-md focus:bg-background focus:px-3 focus:py-2">Skip to content</a>
    <header class="sticky top-0 z-10 border-b bg-background/85 backdrop-blur">
      <div class:list={['mx-auto flex h-14 items-center gap-2 px-4 sm:gap-4', width]}>
        <a href={app} class="flex items-center gap-2 rounded-md font-semibold tracking-tight outline-none focus-visible:ring-2 focus-visible:ring-ring/60">
          <img src={`${base}favicon.svg`} alt="" width="22" height="22" />
          Lodoc
        </a>
        <nav aria-label="Site" class="flex items-center gap-1 text-sm">
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={Astro.url.pathname.startsWith(item.href) ? 'page' : undefined}
                class="rounded-md px-2 py-1.5 whitespace-nowrap text-muted-foreground sm:px-2.5 outline-none hover:bg-accent hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring/60 aria-[current=page]:text-foreground"
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <a
          href={app}
          class="ml-auto inline-flex h-9 shrink-0 items-center rounded-lg bg-primary px-3 whitespace-nowrap sm:px-3.5 text-sm font-medium text-primary-foreground outline-none hover:bg-primary/90 focus-visible:ring-2 focus-visible:ring-ring/60"
        >
          Open Lodoc
        </a>
      </div>
    </header>
    <main id="main" class:list={['mx-auto px-4 pt-12 pb-24', width]}>
      <slot />
    </main>
    <footer class="border-t">
      <div class:list={['mx-auto flex flex-wrap items-center gap-x-4 gap-y-2 px-4 py-6 text-sm text-muted-foreground', width]}>
        <span>Lodoc: notes that stay in your browser.</span>
        <a href={`${base}changelog/rss.xml`} class="ml-auto underline-offset-4 hover:underline">RSS</a>
      </div>
    </footer>
  </body>
</html>
