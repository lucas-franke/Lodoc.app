---
import { getCollection } from 'astro:content'
import AppearanceDemo from '../../components/AppearanceDemo.astro'
import Icon from '../../components/Icon.astro'
import Base from '../../layouts/Base.astro'
import { byVersion, formatDate } from '../../lib/changelog'
import { __iconData as archive } from 'lucide-react/dist/esm/icons/archive-restore.mjs'
import { __iconData as arrow } from 'lucide-react/dist/esm/icons/arrow-right.mjs'
import { __iconData as calendar } from 'lucide-react/dist/esm/icons/calendar-days.mjs'
import { __iconData as command } from 'lucide-react/dist/esm/icons/command.mjs'
import { __iconData as fileInput } from 'lucide-react/dist/esm/icons/file-input.mjs'
import { __iconData as hash } from 'lucide-react/dist/esm/icons/hash.mjs'
// "history" is an alias of rotate-ccw-clock
import { __iconData as history } from 'lucide-react/dist/esm/icons/rotate-ccw-clock.mjs'
import { __iconData as template } from 'lucide-react/dist/esm/icons/layout-template.mjs'
import { __iconData as shield } from 'lucide-react/dist/esm/icons/shield-check.mjs'
import { __iconData as userX } from 'lucide-react/dist/esm/icons/user-x.mjs'
import { __iconData as wifiOff } from 'lucide-react/dist/esm/icons/wifi-off.mjs'

const base = import.meta.env.BASE_URL
const latest = (await getCollection('changelog')).sort(byVersion)[0]
const img = (name: string) => `${base}${name}`

/** The big four, each with a screenshot from the docs */
const features = [
  {
    title: 'Write your notes',
    text: 'Headings, lists, checklists, tables, images: type / and pick one. Link notes with @, tag them with #, and bring back an earlier version whenever you need it.',
    image: 'docs/img/editor',
    alt: 'A note being written, with the menu of blocks open',
    docs: 'docs/writing/',
    more: 'More about writing',
  },
  {
    title: 'Plan on a board',
    text: 'Put notes, text and images side by side on a large canvas, connect them with arrows and group them in frames. Notes on a board stay up to date as you edit them.',
    image: 'docs/img/board',
    alt: 'A board with note cards in a frame and an arrow between two of them',
    docs: 'docs/boards/',
    more: 'More about boards',
  },
  {
    title: 'Use it on your phone',
    text: 'Add Lodoc to your home screen and it opens like an app. On Android, you can share links, text and photos to it from other apps, and they are collected in one note.',
    image: 'docs/img/collected',
    alt: 'The Collected note on a phone, with shared things listed by date',
    docs: 'docs/phone/',
    more: 'More about the phone app',
    phone: true,
  },
  {
    title: 'Make it yours',
    text: 'Pick a colour tint, a paper texture, a serif or sans font and more. Try four looks right here.',
    docs: 'docs/appearance/',
    more: 'More about appearance',
    // A live demo instead of a screenshot
    demo: true,
  },
]

const trust = [
  { icon: userX, title: 'No account', text: 'Open Lodoc and start writing. There is nothing to sign up for.' },
  { icon: shield, title: 'Private', text: 'Your notes are saved in your browser on this device. They are never sent to a server.' },
  { icon: wifiOff, title: 'Works offline', text: 'After your first visit, Lodoc works without an internet connection.' },
  { icon: archive, title: 'Easy to back up', text: 'Save all your notes in one file whenever you like, or let Lodoc do it for you.' },
]

const more = [
  { icon: calendar, title: 'Daily journal', text: 'One note for each day, opened with one click.' },
  { icon: history, title: 'Note history', text: 'See earlier versions of a note and restore one.' },
  { icon: hash, title: 'Tags and links', text: 'Type # to tag a note and @ to link to another one.' },
  { icon: template, title: 'Templates', text: 'Start from a ready-made note, or save your own.' },
  { icon: command, title: 'Quick search', text: 'Press Ctrl+K (⌘K on a Mac) to find any note or action.' },
  { icon: fileInput, title: 'Bring your notes', text: 'Import from Obsidian, Notion or other Markdown files.' },
]
---

<Base
  title="Lodoc: notes that stay on your device"
  description="A free app for notes and boards that runs in your browser. No account, it works offline, and your notes stay on your device."
  image="about/overview-light.png"
  wide
>
  <section class="text-center" aria-labelledby="hero">
    <h1 id="hero" class="mx-auto max-w-2xl font-page text-4xl leading-[1.1] font-bold tracking-tight text-balance sm:text-6xl">
      Notes that stay on your device.
    </h1>
    <p class="mx-auto mt-5 max-w-xl text-lg text-pretty text-muted-foreground">
      Lodoc is a free app for notes and boards. It runs in your browser, on computers and phones, and keeps everything you write on your device.
    </p>
    <div class="page-unscaled mt-8 flex flex-wrap justify-center gap-3">
      <a href={base} class="inline-flex h-11 items-center gap-2 rounded-lg bg-primary px-5 font-medium text-primary-foreground outline-none hover:bg-primary/90 focus-visible:ring-2 focus-visible:ring-ring/60">
        Open Lodoc <Icon icon={arrow} class="size-4" />
      </a>
      <a href={`${base}docs/getting-started/`} class="inline-flex h-11 items-center rounded-lg border border-control-border px-5 font-medium outline-none hover:bg-accent focus-visible:ring-2 focus-visible:ring-ring/60">
        Get started
      </a>
    </div>
    <figure class="shot mx-auto mt-12 max-w-4xl">
      <img src={img('about/overview-light.png')} class="dark:hidden" alt="Lodoc's overview: the Scratchpad with this week's plan, the note to continue with, and recently edited notes as cards" width="1280" height="800" />
      <img src={img('about/overview-dark.png')} class="hidden dark:block" alt="" width="1280" height="800" />
    </figure>
  </section>

  <section aria-label="Why Lodoc" class="mt-20 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {
      trust.map(({ icon, title, text }) => (
        <div>
          <Icon icon={icon} class="size-6 text-(--joy)" />
          <h2 class="mt-3 font-semibold">{title}</h2>
          <p class="mt-1 text-sm text-muted-foreground">{text}</p>
        </div>
      ))
    }
  </section>

  <div class="mt-24 space-y-24">
    {
      features.map((f, i) => (
        <section class="grid items-center gap-8 md:grid-cols-2 md:gap-12" aria-labelledby={`feature-${i}`}>
          <div class:list={[i % 2 === 1 && 'md:order-2']}>
            <h2 id={`feature-${i}`} class="font-page text-3xl font-bold tracking-tight">{f.title}</h2>
            <p class="mt-3 text-lg text-muted-foreground">{f.text}</p>
            <a href={`${base}${f.docs}`} class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-link underline underline-offset-4 hover:no-underline">
              {f.more} <Icon icon={arrow} class="size-3.5" />
            </a>
          </div>
          {f.demo ? (
            <AppearanceDemo />
          ) : (
            <figure class:list={['shot my-0', f.phone ? 'shot-phone' : 'shot-main']}>
              <img src={img(`${f.image}-light.png`)} class="dark:hidden" alt={f.alt} width={f.phone ? 390 : 1280} height={f.phone ? 844 : 800} loading="lazy" />
              <img src={img(`${f.image}-dark.png`)} class="hidden dark:block" alt="" width={f.phone ? 390 : 1280} height={f.phone ? 844 : 800} loading="lazy" />
            </figure>
          )}
        </section>
      ))
    }
  </div>

  <section class="mt-24" aria-labelledby="more">
    <h2 id="more" class="font-page text-3xl font-bold tracking-tight">And a few more things</h2>
    <ul class="mt-8 grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        more.map(({ icon, title, text }) => (
          <li class="flex gap-3">
            <Icon icon={icon} class="mt-0.5 size-5 shrink-0 text-muted-foreground" />
            <span>
              <span class="block font-medium">{title}</span>
              <span class="block text-sm text-muted-foreground">{text}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  {
    latest && (
      <section class="mt-24 rounded-xl border bg-card p-6" aria-labelledby="new">
        <p class="text-sm text-muted-foreground">
          New in {latest.data.version} · {formatDate(latest.data.date)}
        </p>
        <h2 id="new" class="mt-1 text-xl font-semibold">{latest.data.summary}</h2>
        <a href={`${base}changelog/`} class="mt-3 inline-flex items-center gap-1.5 text-sm font-medium text-link underline underline-offset-4 hover:no-underline">
          See what's new <Icon icon={arrow} class="size-3.5" />
        </a>
      </section>
    )
  }

  <section class="mt-24 text-center" aria-labelledby="start">
    <h2 id="start" class="font-page text-3xl font-bold tracking-tight">Ready to start?</h2>
    <p class="mt-3 text-muted-foreground">Open Lodoc and write your first note. It is free, and there is nothing to install.</p>
    <a href={base} class="page-unscaled mt-6 inline-flex h-11 items-center gap-2 rounded-lg bg-primary px-5 font-medium text-primary-foreground outline-none hover:bg-primary/90 focus-visible:ring-2 focus-visible:ring-ring/60">
      Open Lodoc <Icon icon={arrow} class="size-4" />
    </a>
  </section>
</Base>
