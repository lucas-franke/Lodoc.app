---
import { getCollection } from 'astro:content'
import Docs from '../../layouts/Docs.astro'

const base = import.meta.env.BASE_URL
const pages = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order)
---

<Docs title="Lodoc docs" description="How Lodoc works: writing, organizing, boards, the phone app, backups and your data." current={null}>
  <h1 class="font-page text-4xl font-bold tracking-tight">Docs</h1>
  <p class="mt-2 max-w-prose text-muted-foreground">
    Everything about Lodoc, page by page. New here? Start with <a href={`${base}docs/getting-started/`} class="text-foreground underline underline-offset-4 hover:no-underline">Getting started</a>.
  </p>
  <ul class="mt-10 grid gap-3 sm:grid-cols-2">
    {
      pages.map((page) => (
        <li>
          <a
            href={`${base}docs/${page.id}/`}
            class="block h-full rounded-xl border bg-card p-4 outline-none transition-colors hover:border-ring/60 hover:bg-accent/40 focus-visible:ring-2 focus-visible:ring-ring/60"
          >
            <span class="block font-medium">{page.data.title}</span>
            <span class="mt-1 block text-sm text-muted-foreground">{page.data.description}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Docs>
