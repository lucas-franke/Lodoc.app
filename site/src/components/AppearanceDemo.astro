---
// "Make it yours", live: a small mock-up of Lodoc that takes the same looks as the app (the app's own tints,
// textures and corners, src/lib/appearance-options.ts, and its colour rules for [data-look] in tokens.css).
// Four ready-made looks, picked with their swatches: three light ones and a dark one in high contrast. Only the mock-up changes; the page around it keeps its
// plain look, and nothing is carried over to the app.
import { RADIUS_PRESETS, TINTS } from '../../../src/lib/appearance-options'
import Icon from './Icon.astro'
import { __iconData as chevron } from 'lucide-react/dist/esm/icons/chevron-down.mjs'

const LOOKS = [
  { id: 'clean', name: 'Clean', mode: 'light', tint: 'neutral', texture: 'none', pageFont: 'sans', corners: 'sharp', sidebar: 'connected', contrast: 'standard', swatch: 'oklch(1 0 0)' },
  { id: 'sage', name: 'Sage', mode: 'light', tint: 'sage', texture: 'none', pageFont: 'sans', corners: 'rounded', sidebar: 'floating', contrast: 'standard', swatch: 'oklch(0.86 0.07 150)' },
  { id: 'rose-paper', name: 'Rose paper', mode: 'light', tint: 'rose', texture: 'laid', pageFont: 'serif', corners: 'round', sidebar: 'floating', contrast: 'standard', swatch: 'oklch(0.87 0.06 10)' },
  // Half black, half white: the usual sign for contrast
  { id: 'high-contrast', name: 'High contrast', mode: 'dark', tint: 'neutral', texture: 'none', pageFont: 'sans', corners: 'rounded', sidebar: 'connected', contrast: 'high', swatch: 'linear-gradient(90deg, oklch(0.145 0 0) 50%, oklch(1 0 0) 50%)' },
] as const
type Look = (typeof LOOKS)[number]

const tint = (l: Look) => TINTS.find((t) => t.id === l.tint)!
/** What a look is made of, in words: read out with its swatch (the mock-up shows it) */
const describe = (l: Look) =>
  [
    l.mode === 'dark' ? 'Dark' : 'Light',
    l.tint === 'neutral' ? null : `${tint(l).name.toLowerCase()} tint`,
    l.sidebar === 'floating' ? 'floating sidebar' : 'attached sidebar',
    l.texture === 'laid' ? 'laid paper texture' : null,
    `${RADIUS_PRESETS.find((r) => r.id === l.corners)!.name.toLowerCase()} corners`,
    l.pageFont === 'serif' ? 'serif font' : 'sans-serif font',
    l.contrast === 'high' ? 'high contrast' : null,
  ]
    .filter(Boolean)
    .join(', ')
const looks = LOOKS.map((l) => ({ ...l, description: describe(l) }))
---

<div data-demo class="not-prose">
  <!-- The mock-up: its look comes from these attributes, exactly as the app's comes from <html> -->
  <div
    data-look
    data-demo-window
    data-tint="neutral"
    data-texture="none"
    data-page-font="sans"
    data-sidebar="connected"
    style="--tint-h: 0; --tint-c: 0; --radius: 0rem; --page-font: 'Geist Variable', sans-serif;"
    class="demo-window relative flex h-72 overflow-hidden rounded-xl border bg-background text-foreground shadow-sm sm:h-80"
    role="img"
    aria-label="A small model of Lodoc showing the chosen look"
  >
    <div data-demo-sidebar class="demo-sidebar relative z-[2] flex w-[34%] max-w-44 shrink-0 flex-col gap-1 border-r bg-sidebar p-2.5 text-[11px] text-sidebar-foreground">
      <span class="mb-1 flex items-center gap-1 px-1 font-semibold">Lodoc <Icon icon={chevron} class="size-3 text-muted-foreground" /></span>
      <span class="mb-1 rounded-md border px-2 py-1 text-muted-foreground">Search…</span>
      <span class="truncate rounded-md px-2 py-1">Overview</span>
      <span class="truncate rounded-md px-2 py-1">Activity</span>
      <span class="mt-2 px-2 text-[10px] text-muted-foreground">Folders</span>
      <span class="truncate rounded-md px-2 py-1">Work</span>
      <span class="truncate rounded-md bg-sidebar-accent px-2 py-1 pl-4 font-medium">Morning pages</span>
      <span class="truncate rounded-md px-2 py-1 pl-4">Trip plan</span>
    </div>
    <div class="relative min-w-0 flex-1 overflow-hidden px-5 pt-4 sm:px-7">
      <div class="h-14 rounded-lg sm:h-16" style="background-image: linear-gradient(135deg, #43cea2, #185a9d)"></div>
      <p class="mt-3 font-page text-lg leading-tight font-bold tracking-tight sm:text-xl">Morning pages</p>
      <p class="mt-1 text-[10px] text-muted-foreground">Edited just now · 42 words</p>
      <p class="mt-2.5 font-page text-[13px] leading-relaxed">Write a little every day. Small notes turn into ideas, and ideas into plans worth keeping.</p>
      <ul class="mt-2 space-y-1.5 font-page text-[13px]">
        <li class="flex items-center gap-2"><span class="size-3 shrink-0 rounded-[3px] border border-muted-foreground/60"></span>Three things I'm grateful for</li>
        <li class="flex items-center gap-2"><span class="size-3 shrink-0 rounded-[3px] border border-muted-foreground/60"></span>One thing for today</li>
      </ul>
    </div>
  </div>

  <!-- The four looks; arrow keys move between them, like any group of radio buttons -->
  <div class="mt-4 flex flex-wrap gap-x-4 gap-y-3" role="radiogroup" aria-label="Look" data-demo-looks>
    {
      looks.map((l, i) => (
        <button
          type="button"
          role="radio"
          data-look-preset={JSON.stringify(l)}
          aria-checked={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          aria-describedby={`look-${l.id}`}
          class="group flex min-w-20 flex-col whitespace-nowrap items-center gap-1.5 rounded-lg p-1 text-xs text-muted-foreground outline-none hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring aria-checked:font-medium aria-checked:text-foreground"
        >
          <span
            aria-hidden="true"
            class="size-9 rounded-full border border-control-border group-aria-checked:ring-2 group-aria-checked:ring-foreground group-aria-checked:ring-offset-2 group-aria-checked:ring-offset-background"
            style={`background: ${l.swatch}`}
          />
          {l.name}
          <span id={`look-${l.id}`} class="sr-only">{l.description}</span>
        </button>
      ))
    }
  </div>
</div>

<script>
  import { RADIUS_PRESETS, TINTS } from '../../../src/lib/appearance-options'
  import { showPaperTexture } from '../../../src/lib/paper-texture'

  type Look = { mode: 'light' | 'dark'; tint: string; texture: string; pageFont: string; corners: string; sidebar: string; contrast: string }
  const root = document.querySelector<HTMLElement>('[data-demo]')
  const view = root?.querySelector<HTMLElement>('[data-demo-window]')
  const radios = [...(root?.querySelectorAll<HTMLButtonElement>('[data-look-preset]') ?? [])]
  if (root && view && radios.length) {
    const apply = (button: HTMLButtonElement) => {
      const look = JSON.parse(button.dataset.lookPreset!) as Look
      view.classList.toggle('dark', look.mode === 'dark')
      const tint = TINTS.find((t) => t.id === look.tint) ?? TINTS[0]
      view.dataset.tint = tint.id
      view.style.setProperty('--tint-h', String(tint.hue))
      view.style.setProperty('--tint-c', String(tint.chroma))
      view.dataset.texture = look.texture
      if (look.texture === 'paper' || look.texture === 'laid') showPaperTexture(look.texture)
      view.dataset.pageFont = look.pageFont
      view.style.setProperty('--page-font', look.pageFont === 'serif' ? "'Source Serif 4 Variable', serif" : "'Geist Variable', sans-serif")
      const corners = RADIUS_PRESETS.find((r) => r.id === look.corners) ?? RADIUS_PRESETS[1]
      view.style.setProperty('--radius', `${corners.px / 16}rem`)
      view.dataset.sidebar = look.sidebar
      view.dataset.contrast = look.contrast
      for (const r of radios) {
        r.setAttribute('aria-checked', String(r === button))
        r.tabIndex = r === button ? 0 : -1
      }
    }

    root.addEventListener('click', (e) => {
      const button = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-look-preset]')
      if (button) apply(button)
    })
    root.querySelector('[data-demo-looks]')?.addEventListener('keydown', (e) => {
      const key = (e as KeyboardEvent).key
      const step = key === 'ArrowRight' || key === 'ArrowDown' ? 1 : key === 'ArrowLeft' || key === 'ArrowUp' ? -1 : 0
      const at = radios.indexOf(document.activeElement as HTMLButtonElement)
      if (!step || at < 0) return
      e.preventDefault()
      const next = radios[(at + step + radios.length) % radios.length]
      apply(next)
      next.focus()
    })

    apply(radios[0])
  }
</script>
